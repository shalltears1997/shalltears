<launch>
    <!-- gmapping SLAM 算法节点 -->
    
    
    <node pkg="gmapping" type="slam_gmapping" name="mapper">
  <param name="maxUrange" value="10.0" type="double"/>
  <param name="delta" value="0.01"/>
  <param name="xmax" value="30" type="double"/>
  <param name="ymax" value="30" type="double"/>
  <param name="xmin" value="-30" type="double"/>
  <param name="ymin" value="-30" type="double"/>
  
  <!-- 地图更新频率和重采样设置 -->
  <param name="map_update_interval" value="2.0"/>
  <param name="resampleThreshold" value="0.5"/>

  <!-- 线性更新和角度更新频率 -->
  <param name="linearUpdate" value="0.1"/>
  <param name="angularUpdate" value="0.1"/>

  <!-- 增加粒子数以提高精度 -->
  <param name="particles" value="1000"/>
</node>
    
    
    
    
    
    
 <!-- <node pkg="gmapping" type="slam_gmapping" name="mapper">
    <param name="maxUrange" value="8.0" type="double"/>
    <param name="delta" value="0.02"/>
    <param name="xmax" value="30" type="double"/>
    <param name="ymax" value="30" type="double"/>
    <param name="xmin" value="-30" type="double"/>
    <param name="ymin" value="-30" type="double"/>
  </node>
  -->
  <!-- mouse_teleop -->
  <node pkg="mouse_teleop" type="mouse_teleop.py" name="mouse_teleop" respawn="true" >
    <remap from="/mouse_vel" to="/rover_drive" />
    <param name="scale" value="0.5" />
  </node>
    <!-- RViz 可视化节点 -->
    <node pkg="rviz" type="rviz" args="-d $(find ros_master_test)/configuration_files/rviz/gmapping.rviz" name="visualizer" respawn="true" />
</launch>
