<!--
  navigation for lightrover
-->

<launch>
  <!--<node pkg="ros_master_test" type="odometry.py" name="rover_odometry" />-->
  <!-- mapサーバー -->
  <!--マップファイルのパスの指定 -->
  <arg name="map_file" default="$(find ros_master_test)/map/test12.yaml"/>

  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

  <!--
    自己位置推定ノード amcl
    各パラメータについては http://wiki.ros.org/amcl
    を参照してください。
  -->
  <!--<include file="$(find amcl)/examples/amcl_diff.launch" />-->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="/scan"/>
    <param name="gui_publish_rate" value="5.0"/>
    <param name="odom_model_type" value="diff"/>
    <param name="min_particles" value="1200"/>
    <param name="max_particles" value="3000"/>
    <!--<param name="kld_err" value="0.05"/>-->
    <param name="kld_err" value="0.05"/>
    <param name="kld_z" value="0.95"/>
    <!--<param name="kld_z" value="0.95"/>-->
    <param name="odom_alpha1" value="0.8"/>
    <param name="odom_alpha2" value="0.8"/>
    <param name="odom_alpha3" value="0.8"/>
    <param name="odom_alpha4" value="0.8"/>
    <param name="laser_max_beams" value="180"/>
    <param name="laser_z_hit" value="0.9"/>
    <param name="laser_z_short" value="0.05"/>
    <param name="laser_z_max" value="0.3"/>
    <param name="laser_z_rand" value="0.5"/>
    <param name="laser_sigma_hit" value="0.1"/>
    <!--  <param name="laser_lambda_short" value="0.1"/> -->
    <param name="laser_lambda_short" value="0.1"/>
    <param name="laser_model_type" value="likelihood_field"/> 
  <!--  <param name="laser_model_type" value="beam"/> -->
    <param name="laser_likelihood_max_dist" value="6"/>
    <param name="update_min_d" value="0.03"/>
    <!-- <param name="update_min_a" value="0.03"/>-->
    <param name="update_min_a" value="0.01"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link" />
    <param name="resample_interval" value="1"/>
    <param name="transform_tolerance" value="1.0"/>
    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.1"/>
    <param name="use_map_topic" value="false" />
    <param name="initial_pose_x" value="0.0"/>
    <param name="initial_pose_y" value="0.0"/>
    <param name="initial_pose_a" value="0.0"/>
  </node>




  <!--- 経路計画，指令値生成ノード　move_base -->
 
 
<!--  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen"> -->
  <!-- 重映射 cmd_vel 到 /nav_cmd_vel -->
<!--    <remap from="cmd_vel" to="/nav_cmd_vel"/> -->
  <!-- 其他参数和配置 -->
  
<!-- 正确的 -->
<!--  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" args="/cmd_vel:=/rover_drive">  -->

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <remap from="cmd_vel" to="/rover_drive"/>

    <param name="base_global_planner" value="custom_global_planner/CustomPathPlanner"/>

<!--
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
  <remap from="cmd_vel" to="nav_cmd_vel"/>  
-->      
 <!--- 
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
  <remap from="cmd_vel" to="/nav_cmd_vel"/>   -->

    <rosparam file="$(find ros_master_test)/configuration_files/lightrover_costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find ros_master_test)/configuration_files/lightrover_costmap_common_params.yaml" command="load" ns="local_costmap" />
   
    <rosparam file="$(find ros_master_test)/configuration_files/lightrover_local_costmap_params.yaml" command="load" />
    
    <rosparam file="$(find ros_master_test)/configuration_files/lightrover_global_costmap_params.yaml" command="load" />
    <rosparam file="$(find ros_master_test)/configuration_files/lightrover_dwa_local_planner_params.yaml" command="load" />
    <rosparam file="$(find ros_master_test)/configuration_files/lightrover_move_base_params.yaml" command="load" />
  </node>








  <!-- Twist Mux Node -->
 <!--
  <node name="twist_mux" pkg="twist_mux" type="twist_mux" output="screen">
  <rosparam command="load" file="$(find ros_master_test)/config/twist_mux.yaml" />
</node>     
-->
  <!-- Rviz -->
  <node pkg="rviz" type="rviz" args="-d '$(find ros_master_test)/configuration_files/rviz/navigation.rviz'" name="visualizer" respawn="true" />


  
  
</launch>
