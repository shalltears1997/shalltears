<launch>
  <!-- mouse_teleop -->
  <node pkg="mouse_teleop" type="mouse_teleop.py" name="mouse_teleop" respawn="true" >
    <remap from="/mouse_vel" to="/nav_cmd_vel" />
    <param name="scale" value="0.5" />
  </node>
  
    <!-- Twist Mux Node -->
  <node name="twist_mux" pkg="twist_mux" type="twist_mux" output="screen">
  <rosparam command="load" file="$(find ros_master_test)/config/twist_mux.yaml" />
  </node>
</launch>
